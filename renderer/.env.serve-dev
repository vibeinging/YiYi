#The defined variable must start with VITE_APP_ (proxy 变量除外)
# dev 联调:走 Vite dev proxy 到运行中的后端

VITE_APP_ENV = 'dev'
VITE_APP_DEV_PORT = '57131'

# 留空 → axios baseURL 取 window.location.origin(localhost:57131),请求走同源,由下面的 proxy 转发
VITE_APP_BASE_URL = ''
VITE_APP_CALLBACK_BASE_URL = 'http://chat_callback.vexdb.com'

# dev proxy:/api 前缀的请求代理到运行中的后端 Node sidecar(端口 57138)
# 后端路由本身带 /api 前缀,故不 strip;若某后端不带前缀,加 VITE_PROXY_STRIP = '1'
VITE_PROXY_BASE_URL = '/api'
VITE_PROXY_URL = 'http://127.0.0.1:57138'

#image or oss address
VITE_APP_IMAGE_URL = ''
